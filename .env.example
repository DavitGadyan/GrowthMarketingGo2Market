# ---- GrowthPilot backend settings (copy to backend/.env) ----

# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./growthpilot.db
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---- Agents ----
# Leave empty to use a logged-in Claude Code CLI (`claude login`) instead.
ANTHROPIC_API_KEY=
# 1 = deterministic fake runner (no key, no network); 0 = real Claude agents.
GROWTHPILOT_FAKE_AGENTS=0
STRATEGY_MODEL=claude-opus-5-5
CONTENT_MODEL=claude-sonnet-5-5
MAX_BUDGET_USD_PER_STAGE=2.0
MAX_BUDGET_USD_PER_TASK=2.0

# ---- Integrations (all optional) ----
# Firecrawl: deeper competitor research via the firecrawl-mcp stdio server.
FIRECRAWL_API_KEY=
# Higgsfield: remote MCP endpoint + bearer token. Quotes first; renders need approval.
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Gmail: EITHER a stdio MCP server command (drafts only - send tools are blocked) ...
GMAIL_MCP_COMMAND=
# ... OR Google OAuth credentials (reported as connected; wire your own MCP command for execution).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---- Frontend (output/growthpilot/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
